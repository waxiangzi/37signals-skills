      "rails-conventions",
      "rails-best-practices-core"
    ],
    "checks": [
      {
        "name": "指出同名方法冲突/覆盖",
        "any": [
          "冲突",
          "覆盖",
          "同名",
          "collid",
          "shadow",
          "override"
        ]
      },
      {
        "name": "提到全局 include 的机制",
        "any": [
          "include_all_helpers",
          "所有 helper",
          "全部 helper",
          "所有视图",
          "every view",
          "all helpers",
          "共享命名空间",
          "每个视图",
          "所有 .{0,20}helper",
          "一个命名空间",
          "shared namespace"
        ]
      }
    ]
  },
  {
    "id": "verification-gates",
