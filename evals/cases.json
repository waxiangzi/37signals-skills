[
  {
    "id": "helper-naming",
    "prompt": "我想在 app/helpers 下新建 post_format.rb，放几个文本格式化方法。命名上要注意什么？只回答，不要写文件。",
    "expect_any": [
      "rails-conventions",
      "rails-best-practices-core"
    ],
    "checks": [
      {
        "name": "点名这是静默失败：收录只扫 *_helper.rb，zeitwerk:check 抓不到",
        "any": [
          "all_helpers_from_path",
          "zeitwerk[\\s\\S]{0,80}(抓不到|管不着|管不了|不管|不归|不会报|照样全绿|依然全绿|检测不到|发现不了)",
          "helper[\\s\\S]{0,40}不归[\\s\\S]{0,12}zeitwerk",
          "(收录|扫描|加载)[\\s\\S]{0,40}(只扫|只匹配|只认|只看|只收)[\\s\\S]{0,30}_helper"
        ]
      },
      {
        "name": "后果是视图里才炸（undefined method / 根本没被收录）",
        "any": [
          "undefined method",
          "未收录",
          "不被收录",
          "收录不到",
          "没被收录",
          "静默"
        ]
      }
    ],
    "expect_tools": [
      {
        "name": "跑了 helper 收录探针或 zeitwerk:check",
        "cmd": [
          "all_helpers_from_path",
          "zeitwerk:check"
        ]
      }
    ]
  },
  {
    "id": "helper-view-collision",
    "prompt": "我打算在 PostsHelper 里加一个叫 form_id 的方法。Rails 默认把所有 helper 都 include 进每个视图，这样做有什么风险？",
    "expect_any": [
      "rails-conventions",
      "rails-best-practices-core"
    ],
    "checks": [
      {
        "name": "点出被覆盖的包括 ActionView 自己的（私有）方法",
        "any": [
          "私有",
          "private",
          "FormTagHelper",
          "ActionView::Base",
          "field_id"
        ]
      },
      {
        "name": "症状在无关调用方（参数个数/别的方法炸）",
        "any": [
          "wrong number of arguments",
          "参数个数",
          "不相关",
          "无关",
          "别的地方",
          "离调用点很远",
          "hidden_field",
          "field_id"
        ]
      }
    ]
  },
  {
    "id": "verification-gates",
    "prompt": "我改完代码后只跑了 bin/rails test，全绿。这样能算验证完成吗？这个项目还应该跑哪些？",
    "expect_any": [
      "rails-conventions",
      "rails-testing"
    ],
    "checks": [
      {
        "name": "0 failures 与 0 errors 是两个数，errors 要单独盯",
        "any": [
          "0 errors",
          "zero errors",
          "errors 和 failures",
          "failures 和 errors",
          "failures[\\s\\S]{0,24}errors",
          "errors[\\s\\S]{0,24}failures",
          "error 也要",
          "两个计数",
          "分开计数"
        ]
      }
    ],
    "expect_tools": [
      {
        "name": "真去跑了 bin/rails test",
        "cmd": [
          "bin/rails test",
          "bin/rake test"
        ]
      },
      {
        "name": "真去跑了 zeitwerk:check 或 rubocop",
        "cmd": [
          "zeitwerk:check",
          "rubocop"
        ]
      }
    ]
  },
  {
    "id": "assignment-writes-early",
    "prompt": "看 app/models/post.rb 的 tag_names=：它里面直接 self.tags = ...。用户提交表单、标题校验失败时，已有文章的标签会怎样？怎么改？",
    "expect_any": [
      "rails-conventions",
      "rails-best-practices-core"
    ],
    "checks": [
      {
        "name": "在 after_commit 里清空（外层事务回滚时保留，供 422 重显）",
        "any": [
          "after_commit",
          "after_save_commit"
        ]
      }
    ]
  },
  {
    "id": "jobs-idempotent",
    "prompt": "CommentNotificationJob 在 update! 之前如果抛错，重试时会重复发邮件。怎么把它改成幂等的？",
    "expect_any": [
      "rails-jobs"
    ],
    "checks": []
  },
  {
    "id": "migration-not-null",
    "prompt": "我要给 posts 表加一个 NOT NULL 的 slug 列，表里有几百万行，在线迁移怎么写才安全？",
    "expect_any": [
      "rails-migrations"
    ],
    "checks": [
      {
        "name": "大回填移出迁移窗口，或迁移里不碰 app 模型（用 SQL）",
        "any": [
          "script/migrations",
          "脚本",
          "后台任务",
          "不要放[\\s\\S]{0,10}迁移",
          "别放[\\s\\S]{0,10}迁移",
          "移出",
          "原始 SQL",
          "raw SQL",
          "execute\\(\"UPDATE",
          "不要引用[\\s\\S]{0,12}模型",
          "inline AR"
        ]
      }
    ],
    "expect_tools": [
      {
        "name": "读了 db/schema.rb 或迁移目录",
        "cmd": [
          "schema\\.rb",
          "db/migrate"
        ]
      }
    ]
  },
  {
    "id": "webhook-receive",
    "prompt": "我要接收 Stripe 的 webhook：怎么验证签名，并保证同一个事件被重复投递时不会重复处理？",
    "expect_any": [
      "rails-webhooks"
    ],
    "checks": []
  },
  {
    "id": "multitenancy-scope",
    "prompt": "我想给 Post 加多租户：每个 account 只能看到自己的文章。怎么设计才不会在某个查询里漏掉租户条件？",
    "expect_any": [
      "rails-security-multitenancy"
    ],
    "checks": []
  },
  {
    "id": "turbo-stream-broadcast",
    "prompt": "评论创建后，要把新评论实时推给其他正在看这篇文章的人。用 Turbo Streams 怎么做？",
    "expect_any": [
      "rails-hotwire-realtime",
      "hwc-realtime-streaming"
    ],
    "checks": [
      {
        "name": "视图侧 turbo_stream_from 订阅",
        "any": [
          "turbo_stream_from"
        ]
      },
      {
        "name": "服务端广播 API（broadcast_append/replace 或 broadcasts_to）",
        "any": [
          "broadcast_append",
          "broadcast_replace",
          "broadcast_prepend",
          "broadcasts_to",
          "broadcast_"
        ]
      },
      {
        "name": "广播挂在模型回调（after_create_commit / concern），不在控制器",
        "any": [
          "after_create_commit",
          "after_commit",
          "concern",
          "模型里",
          "模型层"
        ]
      }
    ]
  },
  {
    "id": "stimulus-clipboard",
    "prompt": "写一个 Stimulus controller：点击按钮把一段文本复制到剪贴板，按钮上短暂显示“已复制”，并确保不会泄漏定时器。",
    "expect_any": [
      "hwc-stimulus-fundamentals",
      "hwc-ux-feedback"
    ],
    "checks": [],
    "expect_tools": [
      {
        "name": "真写出了 controller 文件（app/javascript/controllers）",
        "cmd": [
          "clipboard_controller\\.js",
          "app/javascript/controllers/"
        ]
      }
    ]
  },
  {
    "id": "controller-tests",
    "prompt": "给 PostsController#create 补测试。哪些该测，哪些不用测？",
    "expect_any": [
      "rails-testing"
    ],
    "checks": [
      {
        "name": "明确不测什么（视图/JS/一行 job/私有方法）",
        "any": [
          "视图[\\s\\S]{0,12}(不用|不必|不该|不需要)测",
          "view[\\s\\S]{0,16}(不用|不必|不该|不需要)",
          "Stimulus[\\s\\S]{0,20}(不用|不必|不测|不该)",
          "JS[\\s\\S]{0,20}(不用|不必|不测|不该)",
          "私有方法[\\s\\S]{0,16}(不测|不用|不必)",
          "不要重复",
          "不重复"
        ]
      }
    ],
    "expect_tools": [
      {
        "name": "真去跑了 bin/rails test",
        "cmd": [
          "bin/rails test",
          "bin/rake test"
        ]
      }
    ]
  },
  {
    "id": "ruby-idiom",
    "prompt": "把这个 Ruby 方法改得更地道： def active_posts   r = []   Post.all.each { |p| r << p if p.published_at != nil }   r end",
    "expect_any": [
      "ruby",
      "dhh"
    ],
    "checks": []
  },
  {
    "id": "dhh-review",
    "prompt": "用 DHH 的风格评审一下 PostsController 的设计，指出该怎么改。",
    "expect_any": [
      "dhh",
      "rails-best-practices-core"
    ],
    "checks": [
      {
        "name": "params.expect 取代 params.require(...).permit",
        "any": [
          "params\\.expect",
          "\\.expect\\("
        ]
      },
      {
        "name": "DHH 的评审形态：最重的先说 + 具体改写/file:line + Ship it 或优先级清单",
        "any": [
          "Ship it",
          "ship it",
          "file:line",
          "posts_controller\\.rb:\\d",
          "优先级",
          "先修",
          "最严重"
        ]
      }
    ],
    "expect_tools": [
      {
        "name": "先看 diff/日志再评审（技能的规定动作）",
        "cmd": [
          "git diff",
          "git log",
          "git show"
        ]
      }
    ]
  },
  {
    "id": "neg-python-gil",
