          "immediately",
          "persist",
          "校验之前",
          "校验前",
          "before validation"
        ]
      },
      {
        "name": "给出 after_save / 记录意图 的修法",
        "any": [
          "after_save",
          "after_commit",
          "意图",
          "pending",
          "@tag_names",
          "instance variable",
          "实例变量"
        ]
      }
    ]
  },
