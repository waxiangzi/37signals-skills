[
  {
    "id": "helper-naming",
    "prompt": "我想在 app/helpers 下新建 post_format.rb，放几个文本格式化方法。命名上要注意什么？只回答，不要写文件。",
    "expect_any": [
      "rails-conventions",
      "rails-best-practices-core"
    ],
    "checks": [
      {
        "name": "提到 _helper 后缀 / Zeitwerk 常量名",
        "any": [
          "_helper\\.rb",
          "PostFormatHelper",
          "post_format_helper"
        ]
      }
    ]
  },
  {
    "id": "helper-view-collision",
    "prompt": "我打算在 PostsHelper 里加一个叫 form_id 的方法。Rails 默认把所有 helper 都 include 进每个视图，这样做有什么风险？",
